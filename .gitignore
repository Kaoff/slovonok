# Python
backend/.venv/
backend/models/*
!backend/models/.gitkeep
__pycache__/
*.pyc

# Desktop app build (the spec in packaging/ is versioned; PyInstaller's other output is not)
backend/build/
backend/dist/
packaging/build/
packaging/dist/
packaging/output/

# Frontend
frontend/node_modules/
frontend/build/
frontend/.svelte-kit/

# Local data (config, media)
backend/data/
packaging/*.log
packaging/*.err
